# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/

# ============================================================================
# Виртуальные окружения
# ============================================================================
venv/
env/
ENV/
.venv/
.env

# ============================================================================
# IDE
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================================
# Артефакты обучения (большие файлы — не нужны в git)
# ============================================================================
# Чекпоинты модели (.pt) - могут весить десятки МБ
artifacts/
*.pt
*.pth

# Обработанные данные (.npz) - десятки МБ
processed_data/
*.npz

# Логи обучения
logs/
runs/

# Сгенерированные отчёты (HTML с графиками - могут быть большими)
reports/*.html
reports/*.png
reports/*.json
trajectory_reports/
trajectory_reports_all/

# Сгенерированные синтетические логи (создаются скриптом)
flight_logs_generated/
# Исходные CSV-логи (flight_logs_source/) НЕ игнорируем -
# они нужны для запуска run_stage0.py на любом устройстве.

# ============================================================================
# Резервные копии и временные файлы
# ============================================================================
*.bak
*.backup
*.tmp
*.temp
*~

# Резервные копии Word (создаются при открытии файла)
~$*.docx
~$*.doc

# Промежуточные docx (рабочие черновики)
*_intermediate.docx
diplom_intermediate.docx

# ============================================================================
# Jupyter
# ============================================================================
.ipynb_checkpoints/
*.ipynb_checkpoints
